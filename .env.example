# Google AI API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=30

# Optimization Configuration
MESA_MAX_ITERATIONS=10
MESA_LEARNING_RATE=0.01
MESA_CONVERGENCE_THRESHOLD=0.95

EVOLUTIONARY_POPULATION_SIZE=20
EVOLUTIONARY_MUTATION_RATE=0.2
EVOLUTIONARY_CROSSOVER_RATE=0.7
EVOLUTIONARY_GENERATIONS=50

SELF_CRITIQUE_ROUNDS=3
SELF_CRITIQUE_QUALITY_THRESHOLD=0.85

# Safety Configuration
SAFETY_CHECK_ENABLED=true
SAFETY_STRICTNESS=medium
AUDIT_LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90
AUDIT_ANONYMIZE_DATA=true

# Knowledge Base Configuration
RAG_ENABLED=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_MAX_RESULTS=10

# Database Configuration (for future use)
DATABASE_URL=sqlite:///./apos.db

# Redis Configuration (for caching, future use)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
